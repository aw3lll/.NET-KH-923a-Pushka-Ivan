<Window x:Class="WpfApp___Lab7.TicketEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TicketEditForm" Height="350" Width="300" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Сеанс:"/>
        <ComboBox x:Name="cmbSession" Margin="0,5">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Film.Title}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Ім'я покупця:"/>
        <TextBox x:Name="txtName" Margin="0,5"/>
        <TextBlock Text="Ряд:"/>
        <TextBox x:Name="txtRow" Margin="0,5"/>
        <TextBlock Text="Місце:"/>
        <TextBox x:Name="txtSeat" Margin="0,5"/>
        <CheckBox x:Name="chkPaid" Content="Оплачено?" Margin="0,10"/>
        <UniformGrid Columns="2">
            <Button Content="Зберегти" Click="btnSave_Click"/>
            <Button Content="Скасувати" Click="btnCancel_Click"/>
        </UniformGrid>
    </StackPanel>
</Window>