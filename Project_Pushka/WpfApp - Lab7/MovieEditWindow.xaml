<Window x:Class="WpfApp___Lab7.MovieEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MovieEditForm" Height="300" Width="300" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Назва фільму:"/>
        <TextBox x:Name="txtTitle" Margin="0,5"/>
        <TextBlock Text="Тривалість (хв):"/>
        <TextBox x:Name="txtDuration" Margin="0,5"/>
        <TextBlock Text="Рейтинг:"/>
        <TextBox x:Name="txtRating" Margin="0,5"/>
        <TextBlock Text="Жанр:"/>
        <TextBox x:Name="txtGenre" Margin="0,5"/>
        <CheckBox x:Name="chk3D" Content="3D?" Margin="0,10"/>
        <UniformGrid Columns="2">
            <Button Content="Зберегти" Click="btnSave_Click" IsDefault="True"/>
            <Button Content="Скасувати" Click="btnCancel_Click" IsCancel="True"/>
        </UniformGrid>
    </StackPanel>
</Window>