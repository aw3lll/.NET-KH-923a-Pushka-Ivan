<Window x:Class="WpfApp___Lab7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp___Lab7"
        Title="Система кінотеатру MVVM" Height="600" Width="1000" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F0F0F0" Padding="10">
            <StackPanel>
                <Button Content="Додати фільм" Command="{Binding AddMovieCommand}" Margin="0,5"/>
                <Button Content="Створити сеанс" Command="{Binding AddSessionCommand}" Margin="0,5"/>
                <Button Content="Оформити квиток" Command="{Binding AddTicketCommand}" Margin="0,5"/>
                <Separator Margin="0,10"/>

                <Button Content="Видалити обране" Background="#FFE1E1" Margin="0,5"
                        Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=ActiveDataGrid}"/>

                <Separator Margin="0,10"/>
                <Button Content="Завантажити JSON" Command="{Binding LoadCommand}" Margin="0,5"/>
                <Button Content="Зберегти у JSON" Command="{Binding SaveCommand}" Margin="0,5"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Column="1">
            <TabItem Header="Фільми">
                <DataGrid x:Name="dgMovies" ItemsSource="{Binding Movies}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Tag>
                        <Binding ElementName="dgMovies" Path="SelectedItem"/>
                    </DataGrid.Tag>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Тривалість" Binding="{Binding DurationMinutes}" Width="100"/>
                        <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="100"/>
                        <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" Width="80"/>
                        <DataGridCheckBoxColumn Header="3D" Binding="{Binding IsThreeD}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Сеанси">
                <DataGrid x:Name="dgSessions" ItemsSource="{Binding Sessions}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Tag>
                        <Binding ElementName="dgSessions" Path="SelectedItem"/>
                    </DataGrid.Tag>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Фільм" Binding="{Binding Film.Title}" Width="*"/>
                        <DataGridTextColumn Header="Зал" Binding="{Binding HallName}" Width="80"/>
                        <DataGridTextColumn Header="Час" Binding="{Binding StartTime, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="140"/>
                        <DataGridTextColumn Header="Ціна" Binding="{Binding TicketPrice}" Width="80"/>
                        <DataGridTextColumn Header="Місць" Binding="{Binding AvailableSeats}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Квитки">
                <DataGrid x:Name="dgTickets" ItemsSource="{Binding Tickets}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Tag>
                        <Binding ElementName="dgTickets" Path="SelectedItem"/>
                    </DataGrid.Tag>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding TicketId}" Width="80"/>
                        <DataGridTextColumn Header="Покупець" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="Сеанс" Binding="{Binding CinemaSession.Film.Title}" Width="*"/>
                        <DataGridTextColumn Header="Ряд" Binding="{Binding RowNumber}" Width="60"/>
                        <DataGridTextColumn Header="Місце" Binding="{Binding SeatNumber}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>