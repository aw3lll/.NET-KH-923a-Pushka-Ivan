<Window x:Class="WpfApp___Lab7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система кінотеатру" Height="600" Width="1000" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F3F3F3" Padding="10">
            <StackPanel>
                <Button Content="Додати фільм" Click="btnAddMovie_Click"/>
                <Button Content="Створити сеанс" Click="btnAddSession_Click"/>
                <Button Content="Оформити квиток" Click="btnAddTicket_Click"/>
                <Separator Margin="0,10"/>
                <Button Content="Видалити обране" Background="#FFE1E1" Click="btnDelete_Click"/>
                <Separator Margin="0,10"/>
                <Button Content="Завантажити JSON" Click="btnLoad_Click"/>
                <Button Content="Зберегти у JSON" Click="btnSave_Click"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Column="1">
            <TabItem Header="Фільми">
                <DataGrid x:Name="dgMovies" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Тривалість (хв)" Binding="{Binding DurationMinutes}" Width="120"/>
                        <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="100"/>
                        <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" Width="80"/>
                        <DataGridCheckBoxColumn Header="3D" Binding="{Binding IsThreeD}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Сеанси">
                <DataGrid x:Name="dgSessions" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Фільм" Binding="{Binding Film.Title}" Width="*"/>
                        <DataGridTextColumn Header="Зал" Binding="{Binding HallName}" Width="80"/>
                        <DataGridTextColumn Header="Час" Binding="{Binding StartTime, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="140"/>
                        <DataGridTextColumn Header="Ціна" Binding="{Binding TicketPrice}" Width="80"/>
                        <DataGridTextColumn Header="Місць" Binding="{Binding AvailableSeats}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Квитки">
                <DataGrid x:Name="dgTickets" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID Квитка" Binding="{Binding TicketId}" Width="100"/>
                        <DataGridTextColumn Header="Покупець" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="Сеанс" Binding="{Binding CinemaSession.Film.Title}" Width="*"/>
                        <DataGridTextColumn Header="Ряд" Binding="{Binding RowNumber}" Width="60"/>
                        <DataGridTextColumn Header="Місце" Binding="{Binding SeatNumber}" Width="60"/>
                        <DataGridCheckBoxColumn Header="Оплачено" Binding="{Binding IsPaid}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>